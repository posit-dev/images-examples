{#-
Below are imports for Bakery's macros. If any are unneeded, they can be removed.
Bakery handles bootstrapping the files into template rendering.
-#}
{%- import "apt.j2" as apt -%}
{%- import "python.j2" as python -%}
{%- import "quarto.j2" as quarto -%}
{%- import "r.j2" as r -%}

# Build Python using uv in a separate stage
{{ python.build_stage(python.build_arg(), prerun=python.declare_build_arg()) }}

FROM docker.io/library/ubuntu:24.04
LABEL org.opencontainers.image.base.name="docker.io/library/ubuntu:24.04"

### ARG declarations ###
ARG DEBIAN_FRONTEND=noninteractive
{{ r.declare_build_arg() }}
{{ python.declare_build_arg() }}
{{ quarto.declare_build_arg() }}

### Install Apt Packages and set up the Posit Pro apt repo ###
{{ apt.run_setup() }}

### Set up the Posit Open apt repo and install tools needed for Quarto ###
# The Open repo hosts the `quarto` deb package (see next RUN). `xz-utils` is
# required to unpack the TinyTeX tarball in the TinyTeX install step.
RUN bash -c "$(curl -1fsSL 'https://dl.posit.co/public/open/setup.deb.sh')" && \
    apt-get install -yqq --no-install-recommends \
        xz-utils && \
    {{ apt.clean_command() | indent(4) }}

# Install Python from previous stage
{{ python.copy_from_build_stage() }}

# Install R
{{ r.run_install(r.build_arg()) }}

### Install Quarto from the Posit Open apt repo ###
# The `quarto` deb installs to /opt/quarto/bin/quarto and symlinks the binary
# into /usr/local/bin/quarto via its postinst script.
RUN apt-get update -yqq && \
    apt-get install -yqq --no-install-recommends \
        quarto={{ quarto.build_arg() }} && \
    {{ apt.clean_command() | indent(4) }}

### Install TinyTeX via Quarto ###
# Installing TinyTeX via Quarto yields a fuller set of LaTeX packages than
# the standalone TinyTeX installer.
RUN /opt/quarto/bin/quarto install tinytex --no-prompt --quiet

# Build Python using uv in a separate stage
FROM ghcr.io/astral-sh/uv:debian-slim AS python-builder

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
ENV UV_PYTHON_INSTALL_DIR=/opt/python
ENV UV_PYTHON_PREFERENCE=only-managed

ARG PYTHON_VERSION
RUN uv python install $PYTHON_VERSION
RUN mv /opt/python/cpython-$PYTHON_VERSION-linux-*/ /opt/python/$PYTHON_VERSION


FROM docker.io/library/ubuntu:24.04
LABEL org.opencontainers.image.base.name="docker.io/library/ubuntu:24.04"

### ARG declarations ###
ARG DEBIAN_FRONTEND=noninteractive
ARG R_VERSION
ARG PYTHON_VERSION
ARG QUARTO_VERSION

### Install Apt Packages and set up the Posit Pro apt repo ###
RUN echo 'Acquire::Retries "3"; Acquire::http::Timeout "30"; Acquire::https::Timeout "30";' > /etc/apt/apt.conf.d/99-retries && \
    apt-get update -yqq --fix-missing && \
    apt-get upgrade -yqq && \
    apt-get dist-upgrade -yqq && \
    apt-get autoremove -yqq --purge && \
    apt-get install -yqq --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        tar && \
    apt-get install -yqq --no-install-recommends locales && \
    localedef -i en_US -f UTF-8 en_US.UTF-8 && \
    bash -c "$(curl -1fsSL 'https://dl.posit.co/public/pro/setup.deb.sh')" && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

### Set up the Posit Open apt repo and install tools needed for Quarto ###
# The Open repo hosts the `quarto` deb package (see next RUN). `xz-utils` is
# required to unpack the TinyTeX tarball in the TinyTeX install step.
RUN bash -c "$(curl -1fsSL 'https://dl.posit.co/public/open/setup.deb.sh')" && \
    apt-get install -yqq --no-install-recommends \
        xz-utils && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*

# Install Python from previous stage
COPY --from=python-builder /opt/python /opt/python

# Install R
RUN apt-get update -yqq && \
    apt-get install -yqq --no-install-recommends \
        r-$R_VERSION && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*

### Install Quarto from the Posit Open apt repo ###
# The `quarto` deb installs to /opt/quarto/bin/quarto and symlinks the binary
# into /usr/local/bin/quarto via its postinst script.
RUN apt-get update -yqq && \
    apt-get install -yqq --no-install-recommends \
        quarto=$QUARTO_VERSION && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*

### Install TinyTeX via Quarto ###
# Installing TinyTeX via Quarto yields a fuller set of LaTeX packages than
# the standalone TinyTeX installer.
RUN --mount=type=secret,id=github_token,required=false \
    GH_TOKEN="$([ -s /run/secrets/github_token ] && cat /run/secrets/github_token)" HOME="/opt" CI=true /opt/quarto/bin/quarto install tinytex --no-prompt --update-path

# Build Python using uv in a separate stage so the final image only contains the
# managed CPython installs, not the uv toolchain.
FROM ghcr.io/astral-sh/uv:debian-slim AS python-builder

ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
ENV UV_PYTHON_INSTALL_DIR=/opt/python
ENV UV_PYTHON_PREFERENCE=only-managed
RUN uv python install 3.14.7
RUN mv /opt/python/cpython-3.14.7-linux-*/ /opt/python/3.14.7


FROM docker.io/posit/workbench:2026.09.0-174.pro3-ubuntu-24.04-min
LABEL org.opencontainers.image.base.name="docker.io/posit/workbench:2026.09.0-174.pro3-ubuntu-24.04-min"

### ARG declarations ###
ARG DEBIAN_FRONTEND=noninteractive

### Install team system dependencies ###
# The Posit Minimal images already have apt configured with the Posit Pro repo
# and ship curl, ca-certificates, gnupg, and tar. Only the team-specific system
# packages need to be installed here.
COPY workbench/2026.09/deps/ubuntu-24.04_packages.txt /tmp/ubuntu-24.04_packages.txt
RUN apt-get update -yqq && \
    test -f /tmp/ubuntu-24.04_packages.txt && sed 's/#.*//' /tmp/ubuntu-24.04_packages.txt | xargs -r apt-get install -yqq --no-install-recommends && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*

### Install Python from the build stage ###

COPY --from=python-builder /opt/python /opt/python

RUN { if [ -L /usr/local/bin/python ] && [ ! -e /usr/local/bin/python ]; then rm /usr/local/bin/python; fi; [ -e /usr/local/bin/python ] || ln -s /opt/python/3.14.7/bin/python /usr/local/bin/python; } && \
    { if [ -L /usr/local/bin/python3 ] && [ ! -e /usr/local/bin/python3 ]; then rm /usr/local/bin/python3; fi; [ -e /usr/local/bin/python3 ] || ln -s /opt/python/3.14.7/bin/python3 /usr/local/bin/python3; } && \
    { if [ -L /usr/local/bin/pip ] && [ ! -e /usr/local/bin/pip ]; then rm /usr/local/bin/pip; fi; [ -e /usr/local/bin/pip ] || ln -s /opt/python/3.14.7/bin/pip /usr/local/bin/pip; } && \
    { if [ -L /usr/local/bin/pip3 ] && [ ! -e /usr/local/bin/pip3 ]; then rm /usr/local/bin/pip3; fi; [ -e /usr/local/bin/pip3 ] || ln -s /opt/python/3.14.7/bin/pip3 /usr/local/bin/pip3; }

### Install R ###

RUN apt-get update -yqq && \
    apt-get install -yqq --no-install-recommends \
        r-4.6.1 && \
    apt-get clean -yqq && \
    rm -rf /var/lib/apt/lists/*

RUN { if [ -L /usr/local/bin/R ] && [ ! -e /usr/local/bin/R ]; then rm /usr/local/bin/R; fi; [ -e /usr/local/bin/R ] || ln -s /opt/R/4.6.1/bin/R /usr/local/bin/R; } && \
    { if [ -L /usr/local/bin/Rscript ] && [ ! -e /usr/local/bin/Rscript ]; then rm /usr/local/bin/Rscript; fi; [ -e /usr/local/bin/Rscript ] || ln -s /opt/R/4.6.1/bin/Rscript /usr/local/bin/Rscript; }

### Install team R packages ###
# Bakery's `r.run_install_packages` generates one `install.packages()` call per R
# version. The `_os` dict tells P3M to serve pre-built Ubuntu 24.04 (noble) binaries
# instead of compiling from source, which is much faster.
COPY workbench/2026.09/deps/r-packages.txt /tmp/r-packages.txt
RUN /opt/R/4.6.1/bin/R --vanilla -e 'install.packages(readLines("/tmp/r-packages.txt"), repos="https://p3m.dev/cran/__linux__/noble/latest", clean = TRUE)' && \
    rm -f /tmp/r-packages.txt

### Install team Python packages ###
COPY workbench/2026.09/deps/python-packages.txt /tmp/python-packages.txt
RUN /opt/python/3.14.7/bin/pip install --no-cache-dir --upgrade --break-system-packages \
        -r /tmp/python-packages.txt && \
    rm -f /tmp/python-packages.txt

# Example of extending a Posit product image to install specific versions of
# R and a set of R packages.
#
# This pattern applies to any Posit product image (Connect, Workbench,
# Package Manager). Replace the FROM line below with the image you are
# extending — for example, posit/connect for a Connect server image.
# Use it to add R to a Minimal image, or to add packages to an image that
# already has R installed.

### Specify the Posit product image to extend ###
ARG PRODUCT_VERSION="2026.05.0"


### Extend the Posit Workbench Minimal image ###
# Also available as docker.io/posit/workbench
FROM ghcr.io/posit-dev/workbench:${PRODUCT_VERSION}-min


### Install R versions ###
RUN RUN_UNATTENDED=1 R_VERSION=4.5.1 bash -c "$(curl -fsSL https://rstd.io/r-install)" && \
    find . -type f -name '[rR]-4.5.1.*\.(deb|rpm)' -delete
RUN RUN_UNATTENDED=1 R_VERSION=4.4.3 bash -c "$(curl -fsSL https://rstd.io/r-install)" && \
    find . -type f -name '[rR]-4.4.3.*\.(deb|rpm)' -delete


### Install R packages from Posit Public Package Manager ###
COPY packages.txt /tmp/packages.txt
RUN /opt/R/4.5.1/bin/R --vanilla -e \
    'install.packages(readLines("/tmp/packages.txt"), repos="https://p3m.dev/cran/__linux__/noble/latest", clean = TRUE)'
RUN /opt/R/4.4.3/bin/R --vanilla -e \
    'install.packages(readLines("/tmp/packages.txt"), repos="https://p3m.dev/cran/__linux__/noble/latest", clean = TRUE)'
